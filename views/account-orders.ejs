<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/mzakka-theme.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">
  <style>body { font-family: 'Noto Sans TC', sans-serif; }</style>
</head>
<body class="mz-body min-h-screen bg-gray-50 text-black" data-logged-in="<%= user ? '1' : '0' %>">

  <%- include('partials/age-modal') %>
  <%- include('partials/header') %>

  <div id="mz-wrapper" class="max-w-4xl mx-auto px-3 sm:px-6 py-8">

    <div class="mb-6 flex items-end justify-between">
      <div>
        <h1 class="text-2xl font-black text-gray-900">我的訂單</h1>
        <p class="mt-1 text-sm text-gray-500">共 <%= total %> 張訂單</p>
      </div>
      <a href="/products" class="text-sm font-bold text-red-600 hover:text-red-700">繼續購物 →</a>
    </div>

    <% if (locals.error) { %>
      <div class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700"><%= error %></div>
    <% } else if (!orders || orders.length === 0) { %>
      <div class="rounded-2xl border border-gray-200 bg-white p-12 text-center shadow-sm">
        <span class="block text-6xl mb-4">📦</span>
        <h2 class="text-lg font-black text-gray-900 mb-1">你仲未有訂單</h2>
        <p class="text-sm text-gray-500 mb-6">睇睇有咩心水，揀好就可以落單。</p>
        <a href="/products" class="inline-block rounded-full bg-red-600 px-8 py-3 font-bold text-white hover:bg-red-700 transition">去購物</a>
      </div>
    <% } else { %>
      <%
        const payLabels = { bank_transfer: '銀行轉帳', fps: 'FPS 轉數快' };
        const payStatusLabels = { pending: '待付款', paid: '已付款', failed: '失敗', refunded: '已退款' };
        const shipStatusLabels = { pending: '待出貨', paid: '待出貨', shipped: '已出貨', delivered: '已送達', cancelled: '已取消' };
        const money = (v) => 'HK$' + Number(v || 0).toFixed(0);
      %>
      <div class="space-y-3">
        <% orders.forEach(o => { %>
          <%
            const orderNo = o.order_number || ('#' + o.id);
            const payBadge = o.payment_status === 'paid' ? 'bg-green-100 text-green-700'
              : o.payment_status === 'pending' ? 'bg-amber-100 text-amber-700'
              : 'bg-gray-100 text-gray-600';
            const shipBadge = o.status === 'cancelled' ? 'bg-gray-200 text-gray-600'
              : o.status === 'delivered' ? 'bg-green-100 text-green-700'
              : o.status === 'shipped' ? 'bg-blue-100 text-blue-700'
              : 'bg-amber-100 text-amber-700';
            const dateStr = (() => { try { return new Date(o.created_at).toLocaleDateString('zh-HK'); } catch(_) { return ''; } })();
          %>
          <a href="/order/<%= o.id %>"
             class="block rounded-2xl border border-gray-200 bg-white p-4 shadow-sm transition hover:border-red-300 hover:shadow">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-gray-100 pb-3">
              <div class="flex items-center gap-2">
                <span class="font-black text-gray-900"><%= orderNo %></span>
                <span class="text-xs text-gray-500"><%= dateStr %></span>
              </div>
              <div class="flex items-center gap-2 text-xs font-bold">
                <span class="rounded-full px-2 py-1 <%= payBadge %>"><%= payStatusLabels[o.payment_status] || o.payment_status || '待付款' %></span>
                <span class="rounded-full px-2 py-1 <%= shipBadge %>"><%= shipStatusLabels[o.status] || o.status || '待出貨' %></span>
              </div>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-2 pt-3 text-sm">
              <div class="text-gray-600">
                <%= o.item_qty || o.item_count || 0 %> 件商品
                <% if (o.payment_method_code) { %>· <%= payLabels[o.payment_method_code] || o.payment_method_code %><% } %>
                <% if (o.freight_collect) { %>· <span class="text-orange-600 font-bold">運費到付</span><% } %>
              </div>
              <div class="font-black text-red-600"><%= money(o.total_amount) %></div>
            </div>
          </a>
        <% }) %>
      </div>

      <% if (totalPages > 1) { %>
        <nav class="mt-6 flex items-center justify-center gap-2 text-sm">
          <% if (page > 1) { %>
            <a class="rounded-full border border-gray-300 px-4 py-2 font-bold text-gray-700 hover:border-red-300" href="?page=<%= page - 1 %>">上一頁</a>
          <% } %>
          <span class="text-gray-500">第 <%= page %> / <%= totalPages %> 頁</span>
          <% if (page < totalPages) { %>
            <a class="rounded-full border border-gray-300 px-4 py-2 font-bold text-gray-700 hover:border-red-300" href="?page=<%= page + 1 %>">下一頁</a>
          <% } %>
        </nav>
      <% } %>
    <% } %>

  </div>

  <%- include('partials/footer') %>
</body>
</html>
