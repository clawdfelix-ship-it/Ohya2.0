<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · OHYA2.0 後台</title>
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/mzakka-theme.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="mz-body min-h-screen text-gray-900">
  <%
    const perms = (session && session.adminPermissions) ? session.adminPermissions : [];
    const isSuperAdmin = !!(session && session.isAdmin);
    function hasPerm(required) {
      if (isSuperAdmin) return true;
      if (!required) return true;
      const reqs = Array.isArray(required) ? required : [required];
      if (perms.includes('*')) return true;
      return reqs.every((r) => {
        if (perms.includes(r)) return true;
        const idx = String(r).indexOf(':');
        if (idx > 0) {
          const prefix = String(r).slice(0, idx);
          if (perms.includes(prefix + ':*')) return true;
        }
        return false;
      });
    }
    const adminName = (session && (session.adminName || session.username)) || '管理員';
    const groups = [
      { label: '概覽', items: [
        { key: 'dashboard', href: '/admin', label: '總覽', icon: '📊' },
      ]},
      { label: '銷售', perm: 'orders:read', items: [
        { key: 'orders', href: '/admin/orders', label: '訂單', icon: '🧾', perm: 'orders:read' },
        { key: 'returns', href: '/admin/returns', label: '售後', icon: '↩️', perm: 'returns:read' },
        { key: 'refunds', href: '/admin/refunds', label: '退款', icon: '💸', perm: 'refunds:read' },
      ]},
      { label: '商品', perm: 'catalog:read', items: [
        { key: 'products', href: '/admin/products', label: '商品', icon: '📦', perm: 'catalog:read' },
        { key: 'categories', href: '/admin/categories', label: '分類', icon: '🗂️', perm: 'catalog:read' },
        { key: 'brands', href: '/admin/brands', label: '品牌', icon: '🏷️', perm: 'catalog:read' },
        { key: 'reviews', href: '/admin/reviews', label: '評論審核', icon: '⭐', perm: 'catalog:write' },
      ]},
      { label: '營銷', items: [
        { key: 'coupons', href: '/admin/coupons', label: '優惠券', icon: '🎟️' },
        { key: 'flash-sales', href: '/admin/flash-sales', label: '閃購', icon: '⚡' },
        { key: 'affiliates', href: '/admin/affiliates', label: '聯盟營銷', icon: '🤝' },
        { key: 'abandoned-carts', href: '/admin/abandoned-carts', label: '遺棄購物車', icon: '🛒' },
        { key: 'blog', href: '/admin/blog', label: '網誌', icon: '📝' },
      ]},
      { label: '庫存與採購', perm: 'inventory:read', items: [
        { key: 'inventory', href: '/admin/inventory', label: '庫存', icon: '🏬', perm: 'inventory:read' },
        { key: 'low-stock', href: '/admin/low-stock', label: '低庫存', icon: '⚠️', perm: 'inventory:read' },
        { key: 'warehouses', href: '/admin/warehouses', label: '倉庫', icon: '🏭', perm: 'inventory:write' },
        { key: 'suppliers', href: '/admin/suppliers', label: '供應商', icon: '🚚', perm: 'inventory:write' },
        { key: 'purchase-orders', href: '/admin/purchase-orders', label: '採購單', icon: '📋', perm: 'inventory:write' },
        { key: 'bulk-skus', href: '/admin/bulk-skus', label: '批量更新', icon: '⚡', perm: 'inventory:bulk' },
      ]},
      { label: '客戶與財務', items: [
        { key: 'users', href: '/admin/users', label: '用戶', icon: '👥', perm: 'users:manage' },
        { key: 'user-tags', href: '/admin/user-tags', label: '用戶標籤', icon: '🏷️' },
        { key: 'reconciliation', href: '/admin/reconciliation', label: '對賬', icon: '🧮', perm: 'reconciliation:read' },
        { key: 'reports', href: '/admin/reports', label: '報表', icon: '📈', perm: 'reports:read' },
      ]},
      { label: '配送與支付', items: [
        { key: 'shipping-methods', href: '/admin/shipping-methods', label: '運送方式', icon: '🚛' },
        { key: 'pickup-points', href: '/admin/pickup-points', label: '提貨點', icon: '📍' },
        { key: 'payment-methods', href: '/admin/payment-methods', label: '支付方式', icon: '💳' },
      ]},
      { label: '系統', adminOnly: true, items: [
        { key: 'settings', href: '/admin/settings', label: '系統設定', icon: '⚙️' },
        { key: 'operation-logs', href: '/admin/operation-logs', label: '操作日誌', icon: '📋' },
      ]},
    ];
  %>
  <div class="mx-auto max-w-[1400px] px-2 pb-6 pt-3 sm:px-4">
    <div class="admin-top flex items-center justify-between">
      <div class="admin-brand">OHYA2.0 <small>商家管理後台</small></div>
      <div class="flex items-center gap-3">
        <a href="/" target="_blank" rel="noopener" class="hidden text-sm font-semibold text-gray-500 hover:text-red-700 sm:inline">查看前台 ↗</a>
        <span class="hidden text-sm text-gray-500 md:inline">👤 <%= adminName %></span>
        <form method="POST" action="/admin/logout" class="m-0">
          <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
          <button class="admin-btn-secondary !min-h-0 !py-1.5 text-xs">登出</button>
        </form>
      </div>
    </div>

    <div class="admin-shell">
      <div class="admin-grid">
        <aside class="admin-nav" aria-label="後台導航">
          <% groups.forEach(group => {
            const visible = group.items.filter(it => {
              if (it.adminOnly || group.adminOnly) return isSuperAdmin;
              return hasPerm(it.perm || group.perm);
            });
            if (!visible.length) return;
          %>
            <div class="admin-nav-group"><%= group.label %></div>
            <% visible.forEach(it => { %>
              <a class="admin-link <%= active === it.key ? 'active' : '' %>" href="<%= it.href %>">
                <span aria-hidden="true"><%= it.icon %></span><span><%= it.label %></span>
              </a>
            <% }); %>
          <% }); %>
        </aside>
        <main class="admin-main">
          <h1 class="admin-page-title"><%= title %></h1>
          <%- include(content) %>
        </main>
      </div>
    </div>
  </div>
</body>
</html>
