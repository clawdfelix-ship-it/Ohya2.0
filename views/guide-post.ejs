<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <% const _pageTitle = (typeof seo !== "undefined" && seo && seo.title) ? seo.title : title; %><title><%= _pageTitle %><%- String(_pageTitle).includes("OHYA2.0") ? "" : " · OHYA2.0" %></title>
  <%- include('partials/seo-meta') %>
  <script src="https://cdn.tailwindcss.com"></script>
  <%- include('partials/theme-head') %>
  <link rel="stylesheet" href="/css/mzakka-theme.css">
  <link rel="stylesheet" href="/css/interactions.css">
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
</head>
<body class="mz-body min-h-screen text-gray-200" data-logged-in="<%= user ? '1' : '0' %>">
  <%- include('partials/age-modal') %>
  <%- include('partials/header') %>

  <div id="mz-wrapper" class="mz-wrapper max-w-7xl mx-auto px-2 mt-4 mb-4">
    <div class="mz-3col">
      <%- include('partials/sidebar-left') %>

      <div id="wrap_center" class="min-w-0">
        <article class="max-w-4xl mx-auto px-0 sm:px-4 lg:px-6 py-6">
          <nav class="mb-3 text-xs text-gray-500" aria-label="麵包屑">
            <a href="/" class="hover:text-gold-light">首頁</a>
            <span class="mx-1">/</span>
            <a href="/guide" class="hover:text-gold-light">選購指南</a>
            <span class="mx-1">/</span>
            <span class="text-gray-300"><%= post.title %></span>
          </nav>

          <h1 class="mz-display text-2xl sm:text-3xl font-black text-white mb-3"><%= post.title %></h1>

          <% if (post.publish_at) { %>
            <p class="mb-5 text-xs text-gray-500">發佈日期：<%= new Date(post.publish_at).toLocaleDateString('zh-HK', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
          <% } %>

          <% if (post.featured_image) { %>
            <div class="mb-6 rounded-2xl overflow-hidden border border-ink-600 bg-ink-800">
              <img src="<%= post.featured_image %>" alt="<%= post.title %>" class="w-full h-auto">
            </div>
          <% } %>

          <div class="info-card rounded-2xl border border-ink-600 bg-ink-850 p-5 sm:p-8 text-[15px] leading-relaxed text-gray-200 shadow-card">
            <%- post.content %>
          </div>

          <div class="mt-6 rounded-2xl border border-ink-600 bg-ink-850 p-5">
            <div class="mb-3 text-sm font-bold text-white">相關分類</div>
            <div class="flex flex-wrap gap-2">
              <a href="/products" class="rounded-full border border-ink-600 px-3 py-1.5 text-xs font-semibold text-gray-300 transition hover:border-gold/50 hover:text-gold-light">全部商品</a>
              <a href="/products?category=storefront-new" class="rounded-full border border-ink-600 px-3 py-1.5 text-xs font-semibold text-gray-300 transition hover:border-gold/50 hover:text-gold-light">新到推介</a>
              <a href="/guide" class="rounded-full border border-ink-600 px-3 py-1.5 text-xs font-semibold text-gray-300 transition hover:border-gold/50 hover:text-gold-light">更多指南</a>
            </div>
          </div>
        </article>
      </div>

      <%- include('partials/sidebar-right') %>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
