<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/mzakka-theme.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <style>
    body {
      font-family: 'Noto Sans TC', sans-serif;
    }
    .jpn-bracket::before { content: '【'; }
    .jpn-bracket::after { content: '】'; }
    .product-grid {
      gap: 0.75rem;
    }
    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .modal-animate {
      animation: slideDown 0.3s ease-out;
    }
  </style>
</head>
<body class="mz-body min-h-screen bg-gray-50 text-black" data-logged-in="<%= user ? '1' : '0' %>">
  <% const centerModules = homeModules && Array.isArray(homeModules.center) ? homeModules.center : []; %>
  <% const featuredCategories = Array.isArray(categoriesTree) ? categoriesTree.slice(0, 8) : []; %>

  <%- include('partials/age-modal') %>

  <%- include('partials/header') %>

  <div id="mz-wrapper" class="max-w-7xl mx-auto px-3 py-6">
    <div class="lg:grid lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-6">
      <%- include('partials/sidebar-left') %>

      <div id="wrap_center" class="min-w-0">
        <section class="mb-6 rounded-3xl border border-gray-200 bg-white p-5 shadow-sm">
          <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
              <p class="text-sm font-semibold uppercase tracking-[0.2em] text-red-600">OHYA2.0 Store</p>
              <h1 class="mt-2 text-3xl font-black text-gray-900">簡潔啲搵到想買嘅商品</h1>
              <p class="mt-3 max-w-2xl text-sm leading-6 text-gray-500">日本直送人氣男士護理及生活雜貨，新品定期到港，滿額即享免運優惠。</p>
            </div>
            <div class="flex flex-wrap gap-3">
              <a href="/products?page=1" class="rounded-full bg-red-700 px-5 py-3 text-sm font-bold text-white hover:bg-red-800">立即選購</a>
              <a href="#featured-categories" class="rounded-full border border-gray-300 px-5 py-3 text-sm font-semibold text-gray-700 hover:border-red-300 hover:text-red-700">熱門分類</a>
            </div>
          </div>
        </section>

        <% if (centerModules.length) { %>
          <section class="mb-6 grid gap-4 md:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
            <a href="<%= centerModules[0].href || '/products?page=1' %>" class="overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-sm">
              <img src="<%= centerModules[0].image_url %>" alt="<%= centerModules[0].title || '活動' %>" fetchpriority="high" decoding="async" class="h-full w-full object-cover">
            </a>
            <div class="grid gap-4">
              <% centerModules.slice(1, 3).forEach(module => { %>
                <a href="<%= module.href || '/products?page=1' %>" class="overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-sm">
                  <img src="<%= module.image_url %>" alt="<%= module.title || '活動' %>" loading="lazy" decoding="async" class="h-full w-full object-cover">
                </a>
              <% }) %>
            </div>
          </section>
        <% } %>

        <section id="featured-categories" class="mb-6 rounded-3xl border border-gray-200 bg-white p-5 shadow-sm">
          <div class="mb-4 flex items-center justify-between">
            <div>
              <h2 class="text-xl font-black text-gray-900">熱門分類</h2>
              <p class="mt-1 text-sm text-gray-500">由首頁直達最常睇嘅類別，快速搵到心水貨品</p>
            </div>
            <a href="/products?page=1" class="text-sm font-semibold text-red-700 hover:underline">瀏覽全部商品</a>
          </div>
          <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
            <% featuredCategories.forEach(category => { %>
              <a href="/products?category=<%= encodeURIComponent(category.slug) %>&page=1" class="rounded-2xl border border-gray-200 bg-gray-50 px-4 py-4 transition hover:border-red-200 hover:bg-red-50">
                <div class="text-sm font-bold text-gray-900"><%= category.name %></div>
                <div class="mt-1 text-xs text-gray-500"><%= category.count %> 件商品</div>
              </a>
            <% }) %>
          </div>
        </section>

        <section class="mb-6 grid gap-6 <%= hasSales ? 'xl:grid-cols-[minmax(0,0.9fr)_minmax(0,1.6fr)]' : '' %>">
          <% if (hasSales) { %>
          <section id="mzakka-ranking" class="overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-sm">
            <div class="border-b border-gray-200 px-5 py-4">
              <h2 class="text-xl font-black text-gray-900">人氣排行</h2>
              <p class="mt-1 text-sm text-gray-500">根據真實銷量排名，近期最受歡迎嘅商品</p>
            </div>
            <div class="divide-y divide-gray-100">
              <% (rankingProducts || []).slice(0, 6).forEach((p, idx) => { %>
                <a href="/product/<%= p.id %>" class="flex gap-3 px-5 py-4 hover:bg-gray-50">
                  <div class="flex h-16 w-16 flex-shrink-0 items-center justify-center rounded-2xl bg-gray-100">
                    <% if (p.image) { %>
                      <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy" decoding="async" class="h-full w-full rounded-2xl object-cover">
                    <% } %>
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="text-xs font-semibold text-red-600">No. <%= idx + 1 %></div>
                    <div class="mt-1 line-clamp-2 text-sm font-bold text-gray-900"><%= p.name %></div>
                    <div class="mt-2 text-sm font-black text-red-700"><%= formatPrice(p.price) %></div>
                  </div>
                </a>
              <% }) %>
              <% if (!rankingProducts || rankingProducts.length === 0) { %>
                <div class="px-5 py-8 text-sm text-gray-500">暫時未有商品</div>
              <% } %>
            </div>
          </section>
          <% } %>

          <section class="overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-sm">
            <div class="flex items-center justify-between border-b border-gray-200 px-5 py-4">
              <div>
                <h2 class="text-xl font-black text-gray-900">最新上架</h2>
                <p class="mt-1 text-sm text-gray-500">新到港嘅人氣新品，緊貼日本最新貨況</p>
              </div>
              <a href="/products?page=1" class="text-sm font-semibold text-red-700 hover:underline">查看全部</a>
            </div>
            <div class="p-5">
              <div class="grid grid-cols-2 gap-4 md:grid-cols-3 xl:grid-cols-4">
                <% (newProducts || []).slice(0, 12).forEach(product => { %>
                  <div class="group flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white transition hover:-translate-y-0.5 hover:border-red-200 hover:shadow-md">
                    <a href="/product/<%= product.id %>" class="block aspect-square bg-gray-100" aria-label="<%= product.name %>">
                      <% if (product.image) { %>
                        <img src="<%= product.image %>" alt="" loading="lazy" decoding="async" class="h-full w-full object-cover transition group-hover:scale-105">
                      <% } %>
                    </a>
                    <div class="flex flex-1 flex-col p-3">
                      <div class="truncate text-[11px] text-gray-500"><%= product.category %></div>
                      <div class="mt-1 min-h-[2.5rem] line-clamp-2 text-sm font-bold text-gray-900">
                        <a href="/product/<%= product.id %>" class="transition hover:text-red-700"><%= product.name %></a>
                      </div>
                      <div class="mt-3 flex items-center justify-between gap-2">
                        <span class="text-sm font-black text-red-700"><%= formatPrice(product.price) %></span>
                        <% if (Number(product.stock) <= 0) { %>
                          <span class="inline-flex min-h-[44px] items-center rounded-full bg-gray-300 px-4 text-xs font-semibold text-gray-500">缺貨</span>
                        <% } else { %>
                          <button type="button" data-add-to-cart data-product-id="<%= product.id %>" aria-label="加入購物車" class="flex min-h-[44px] items-center justify-center rounded-full border border-gray-300 px-4 text-xs font-semibold text-gray-700 transition hover:border-red-300 hover:text-red-700 active:scale-95">
                            加入
                          </button>
                        <% } %>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
          </section>
        </section>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script id="mz-products" type="application/json"><%- JSON.stringify(rankingProducts || []) %></script>
  <script src="/js/cart-client.js"></script>

  <script>
    // Age Verification
    function checkAgeVerification() {
      const verified = localStorage.getItem('ageVerified');
      if (!verified) {
        document.getElementById('ageModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    }
    
    function verifyAge(isAdult) {
      if (isAdult) {
        localStorage.setItem('ageVerified', 'true');
        document.getElementById('ageModal').classList.add('hidden');
        document.body.style.overflow = '';
      } else {
        window.location.href = 'https://www.google.com';
      }
    }
    
    // 購物車數字由共享 cart-client（MZCart.refreshCount）負責

    // Mobile Category Toggle
    function toggleCategories() {
      // Only run on mobile
      if (window.innerWidth < 1024) {
        const catList = document.getElementById('catList');
        const catToggle = document.getElementById('catToggle');
        if (catList.classList.contains('hidden')) {
          catList.classList.remove('hidden');
          catToggle.textContent = '▲';
        } else {
          catList.classList.add('hidden');
          catToggle.textContent = '▼';
        }
      }
    }
    
    // Initialize
    document.addEventListener('DOMContentLoaded', function() {
      checkAgeVerification();
    });
  </script>
</body>
</html>
