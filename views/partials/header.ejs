  <% const categoryOptions = Array.isArray(categories) ? categories : []; %>
<div class="mz-readprogress" data-scroll-progress aria-hidden="true"><span style="background:linear-gradient(90deg,#d4af37,#f5d76e)"></span></div>
  <header class="mz-header sticky top-0 z-50 border-b border-ink-700 bg-ink-950/85 backdrop-blur">
    <div class="max-w-7xl mx-auto px-3 py-3">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 lg:flex-nowrap lg:gap-4">
        <button type="button" class="-ml-1 flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-gray-300 hover:bg-ink-700 active:scale-95 lg:hidden" aria-label="開啟分類選單" aria-expanded="false" aria-controls="mz-mobile-menu-panel" data-mobile-menu-open>
          <svg class="mz-burger" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
            <line class="mz-burger__line mz-burger__line--1" x1="3" y1="6" x2="21" y2="6"></line>
            <line class="mz-burger__line mz-burger__line--2" x1="3" y1="12" x2="21" y2="12"></line>
            <line class="mz-burger__line mz-burger__line--3" x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <a href="/" class="flex items-center gap-2 flex-shrink-0 rounded-xl bg-white p-1 shadow-md ring-1 ring-gold/30" aria-label="OHYA2.0 首頁">
          <img src="/img/logo.png" alt="OHYA 大人のおもちゃ" class="h-9 sm:h-11 w-auto rounded-lg" width="2194" height="695">
        </a>

        <a href="/products?page=1" class="hidden md:inline-flex items-center rounded-full border border-ink-500 px-3 py-2 text-xs font-semibold text-gray-300 hover:border-gold/60 hover:text-gold-light">
          全部商品
        </a>

        <form action="/products" method="get" class="order-last w-full min-w-0 lg:order-none lg:w-auto lg:flex-1" data-search-form>
          <div class="relative flex items-stretch overflow-hidden rounded-full border border-ink-600 bg-ink-800 focus-within:border-gold/60 focus-within:ring-2 focus-within:ring-gold/15" data-search-combobox>
            <%# 全分類分組下拉：optgroup=頂層分類，只列子分類；頂層自身放喺組內第一項 %>
            <select name="category" aria-label="按分類篩選" class="hidden lg:block w-44 bg-ink-700 px-3 text-xs text-gray-300 focus:outline-none" data-search-category>
              <option value="all" <%= (!selectedCategorySlug || selectedCategorySlug === 'all') ? 'selected' : '' %>>全部商品</option>
              <% (Array.isArray(categoriesTree) ? categoriesTree : []).forEach(root => { %>
                <optgroup label="<%= root.name %>">
                  <option value="<%= root.slug %>" <%= selectedCategorySlug === root.slug ? 'selected' : '' %><%= root.count ? ' (' + root.count + ')' : '' %>>　<%= root.name %></option>
                  <% (root.children || []).forEach(child => { %>
                    <option value="<%= child.slug %>" <%= selectedCategorySlug === child.slug ? 'selected' : '' %>>　<%= child.name %></option>
                  <% }) %>
                </optgroup>
              <% }) %>
            </select>
            <input name="q" type="text" role="combobox" aria-expanded="false" aria-controls="mz-search-panel" aria-autocomplete="list" autocomplete="off" value="<%= typeof q === 'string' ? q : '' %>" placeholder="搜尋商品、分類、關鍵字" class="min-w-0 flex-1 bg-transparent px-4 py-2.5 text-sm text-gray-100 placeholder:text-gray-500 focus:outline-none" data-search-input>
            <button type="submit" class="shrink-0 whitespace-nowrap bg-wine px-4 sm:px-5 text-sm font-bold text-white hover:bg-wine-light">搜尋</button>
          </div>
          <div id="mz-search-panel" class="mz-search-panel hidden" role="listbox" aria-label="搜尋建議" data-search-panel></div>
        </form>

        <div class="flex shrink-0 items-center gap-2 text-xs sm:gap-3">
          <a href="/cart" class="flex items-center gap-1 rounded-full border border-ink-500 px-3 py-2 font-semibold text-gray-300 hover:border-gold/60 hover:text-gold-light">
            <span>購物車</span>
            <span class="rounded-full bg-wine px-2 py-0.5 text-[10px] font-bold text-white" id="cart-count">0</span>
          </a>
          <% if (user) { %>
            <a href="/account" class="hidden sm:inline font-medium text-gray-300 hover:text-gold-light">會員中心</a>
          <% } else { %>
            <a href="/login" class="hidden sm:inline font-medium text-gray-300 hover:text-gold-light"><%= t('nav.login') %></a>
          <% } %>
        </div>
      </div>
    </div>
  </header>

  <%# 手機左上角漢堡選單：全局分類抽屜。必須放喺 </header> 外面——header 有 backdrop-blur 會令 fixed 子元素被鎖做包含塊，抽屜會被 header 高度裁走 %>
  <% const headerMenuTree = Array.isArray(categoriesTree) ? categoriesTree : []; %>
  <% const headerMenuActiveSlug = typeof selectedCategorySlug === 'string' ? selectedCategorySlug : null; %>
  <% const headerNodeContainsActive = function nodeContainsActive(node, slug) {
    if (!node || !slug) return false;
    if (node.slug === slug) return true;
    return Array.isArray(node.children) && node.children.some((child) => nodeContainsActive(child, slug));
  }; %>
  <div class="fixed inset-0 z-[80] mz-drawer lg:hidden" id="mz-mobile-menu-panel" data-mobile-menu-panel>
    <button type="button" class="mz-drawer-scrim absolute inset-0 bg-black/45" aria-label="關閉分類選單" data-mobile-menu-close></button>
    <div class="mz-drawer-surface absolute inset-y-0 left-0 flex w-full max-w-sm" role="dialog" aria-modal="true" aria-label="商品分類選單">
      <div class="flex h-full w-full flex-col bg-ink-900 shadow-2xl">
        <div class="flex items-center justify-between border-b border-ink-700 px-4 py-4">
          <div>
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-gold">Menu</div>
            <div class="mz-display mt-1 text-lg font-black text-white">商品分類</div>
          </div>
          <button type="button" class="flex h-10 w-10 items-center justify-center rounded-full border border-ink-600 text-gray-300 active:scale-95" aria-label="關閉" data-mobile-menu-close>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg>
          </button>
        </div>

        <div class="border-b border-ink-700 px-3 py-3">
          <% if (typeof user !== 'undefined' && user) { %>
            <a href="/account" class="mb-2 flex items-center justify-between rounded-2xl border border-gold/40 bg-gold/10 px-3 py-3 text-sm font-bold text-gold-light">
              <span>👤 會員中心</span>
            </a>
          <% } %>
          <a href="/products?page=1" class="flex items-center justify-between rounded-2xl border border-ink-600 px-3 py-3 text-sm font-semibold text-gray-200">
            <span>全部商品</span>
          </a>
        </div>

        <div class="flex-1 space-y-2 overflow-y-auto bg-ink-850 px-3 py-3" data-mobile-menu-links>
          <% headerMenuTree.forEach((node) => { %>
            <%- include('category-mobile-node', { node, depth: 0, activeSlug: headerMenuActiveSlug, nodeContainsActive: headerNodeContainsActive }) %>
          <% }) %>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/interactions.js" defer></script>
  <script src="/js/search-autocomplete.js" defer></script>
