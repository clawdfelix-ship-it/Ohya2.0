  <% const categoryOptions = Array.isArray(categories) ? categories : []; %>
  <header class="mz-header sticky top-0 z-50 border-b border-gray-200 bg-white/95 backdrop-blur">
    <div class="max-w-7xl mx-auto px-3 py-3">
      <div class="flex items-center gap-3 lg:gap-4">
        <button type="button" class="-ml-1 flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-gray-700 hover:bg-gray-100 active:scale-95 lg:hidden" aria-label="開啟分類選單" aria-expanded="false" aria-controls="mz-mobile-menu-panel" data-mobile-menu-open>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <a href="/" class="flex items-center gap-2 flex-shrink-0">
          <span class="text-2xl font-black tracking-tight text-red-700">OHYA2.0</span>
        </a>

        <a href="/products?page=1" class="hidden md:inline-flex items-center rounded-full border border-gray-300 px-3 py-2 text-xs font-semibold text-gray-700 hover:border-red-300 hover:text-red-700">
          全部商品
        </a>

        <form action="/products" method="get" class="flex-1 min-w-0">
          <div class="flex items-stretch overflow-hidden rounded-full border border-gray-300 bg-white shadow-sm focus-within:border-red-400 focus-within:ring-2 focus-within:ring-red-100">
            <select name="category" class="hidden lg:block w-44 bg-gray-50 px-3 text-xs text-gray-600 focus:outline-none">
              <% categoryOptions.slice(0, 50).forEach(cat => { %>
                <option value="<%= cat.slug %>" <%= (typeof selectedCategorySlug === 'string' && selectedCategorySlug === cat.slug) ? 'selected' : '' %>><%= cat.name %></option>
              <% }) %>
            </select>
            <input name="q" type="text" value="<%= typeof q === 'string' ? q : '' %>" placeholder="搜尋商品、分類、關鍵字" class="min-w-0 flex-1 px-4 py-2.5 text-sm focus:outline-none">
            <button type="submit" class="bg-red-700 px-5 text-sm font-bold text-white hover:bg-red-800">搜尋</button>
          </div>
        </form>

        <div class="flex shrink-0 items-center gap-2 text-xs sm:gap-3">
          <a href="/cart" class="flex items-center gap-1 rounded-full border border-gray-300 px-3 py-2 font-semibold text-gray-700 hover:border-red-300 hover:text-red-700">
            <span>購物車</span>
            <span class="rounded-full bg-red-700 px-2 py-0.5 text-[10px] font-bold text-white" id="cart-count">0</span>
          </a>
          <% if (user) { %>
            <a href="/account/orders" class="hidden sm:inline font-medium text-gray-700 hover:text-red-700">我的訂單</a>
          <% } else { %>
            <a href="/login" class="hidden sm:inline font-medium text-gray-700 hover:text-red-700"><%= t('nav.login') %></a>
          <% } %>
        </div>
      </div>
    </div>
  </header>

  <%# 手機左上角漢堡選單：全局分類抽屜。必須放喺 </header> 外面——header 有 backdrop-blur 會令 fixed 子元素被鎖做包含塊，抽屜會被 header 高度裁走 %>
  <% const headerMenuTree = Array.isArray(categoriesTree) ? categoriesTree : []; %>
  <% const headerMenuActiveSlug = typeof selectedCategorySlug === 'string' ? selectedCategorySlug : null; %>
  <% const headerNodeContainsActive = function nodeContainsActive(node, slug) {
    if (!node || !slug) return false;
    if (node.slug === slug) return true;
    return Array.isArray(node.children) && node.children.some((child) => nodeContainsActive(child, slug));
  }; %>
  <div class="fixed inset-0 z-[80] hidden lg:hidden" id="mz-mobile-menu-panel" data-mobile-menu-panel>
    <button type="button" class="absolute inset-0 bg-black/45" aria-label="關閉分類選單" data-mobile-menu-close></button>
    <div class="absolute inset-y-0 left-0 flex w-full max-w-sm" role="dialog" aria-modal="true" aria-label="商品分類選單">
      <div class="flex h-full w-full flex-col bg-white shadow-2xl">
        <div class="flex items-center justify-between border-b border-gray-200 px-4 py-4">
          <div>
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-gray-500">Menu</div>
            <div class="mt-1 text-lg font-black text-gray-900">商品分類</div>
          </div>
          <button type="button" class="flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 text-gray-600 active:scale-95" aria-label="關閉" data-mobile-menu-close>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg>
          </button>
        </div>

        <div class="border-b border-gray-100 px-3 py-3">
          <a href="/products?page=1" class="flex items-center justify-between rounded-2xl border border-gray-200 px-3 py-3 text-sm font-semibold text-gray-700">
            <span>全部商品</span>
          </a>
        </div>

        <div class="flex-1 space-y-2 overflow-y-auto bg-gray-50 px-3 py-3" data-mobile-menu-links>
          <% headerMenuTree.forEach((node) => { %>
            <%- include('category-mobile-node', { node, depth: 0, activeSlug: headerMenuActiveSlug, nodeContainsActive: headerNodeContainsActive }) %>
          <% }) %>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function initMobileHeaderMenu() {
      const panel = document.getElementById('mz-mobile-menu-panel');
      const openBtn = document.querySelector('[data-mobile-menu-open]');
      if (!panel || !openBtn) return;
      const closeBtns = panel.querySelectorAll('[data-mobile-menu-close]');

      function setOpen(nextOpen) {
        panel.classList.toggle('hidden', !nextOpen);
        document.body.classList.toggle('overflow-hidden', nextOpen);
        openBtn.setAttribute('aria-expanded', nextOpen ? 'true' : 'false');
      }

      openBtn.addEventListener('click', () => setOpen(true));
      closeBtns.forEach((btn) => btn.addEventListener('click', () => setOpen(false)));
      panel.addEventListener('click', (event) => {
        if (event.target.closest('a')) setOpen(false);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setOpen(false);
      });
    })();
  </script>
