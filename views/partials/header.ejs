  <% const categoryOptions = Array.isArray(categories) ? categories : []; %>
  <header class="mz-header sticky top-0 z-50 border-b border-gray-200 bg-white/95 backdrop-blur">
    <div class="max-w-7xl mx-auto px-3 py-3">
      <div class="flex items-center gap-3 lg:gap-4">
        <a href="/" class="flex items-center gap-2 flex-shrink-0">
          <span class="text-2xl font-black tracking-tight text-red-700">OHYA2.0</span>
        </a>

        <a href="/products?page=1" class="hidden md:inline-flex items-center rounded-full border border-gray-300 px-3 py-2 text-xs font-semibold text-gray-700 hover:border-red-300 hover:text-red-700">
          全部商品
        </a>

        <form action="/products" method="get" class="flex-1 min-w-0">
          <div class="flex items-stretch overflow-hidden rounded-full border border-gray-300 bg-white shadow-sm focus-within:border-red-400 focus-within:ring-2 focus-within:ring-red-100">
            <select name="category" class="hidden lg:block w-44 bg-gray-50 px-3 text-xs text-gray-600 focus:outline-none">
              <% categoryOptions.slice(0, 50).forEach(cat => { %>
                <option value="<%= cat.slug %>" <%= (typeof selectedCategorySlug === 'string' && selectedCategorySlug === cat.slug) ? 'selected' : '' %>><%= cat.name %></option>
              <% }) %>
            </select>
            <input name="q" type="text" value="<%= typeof q === 'string' ? q : '' %>" placeholder="搜尋商品、分類、關鍵字" class="min-w-0 flex-1 px-4 py-2.5 text-sm focus:outline-none">
            <button type="submit" class="bg-red-700 px-5 text-sm font-bold text-white hover:bg-red-800">搜尋</button>
          </div>
        </form>

        <div class="flex shrink-0 items-center gap-2 text-xs sm:gap-3">
          <a href="/cart" class="flex items-center gap-1 rounded-full border border-gray-300 px-3 py-2 font-semibold text-gray-700 hover:border-red-300 hover:text-red-700">
            <span>購物車</span>
            <span class="rounded-full bg-red-700 px-2 py-0.5 text-[10px] font-bold text-white" id="cart-count">0</span>
          </a>
          <% if (user) { %>
            <a href="/account/orders" class="hidden sm:inline font-medium text-gray-700 hover:text-red-700">我的訂單</a>
          <% } else { %>
            <a href="/login" class="hidden sm:inline font-medium text-gray-700 hover:text-red-700"><%= t('nav.login') %></a>
          <% } %>
        </div>
      </div>
    </div>
  </header>
