<% const mobileCategoryTree = Array.isArray(categoriesTree) ? categoriesTree : []; %>
<% const mobileSpecialEntries = Array.isArray(categorySpecials) ? categorySpecials : []; %>
<% const mobileActiveSlug = typeof selectedCategorySlug === 'string' ? selectedCategorySlug : null; %>
<% const mobileSelectedName = mobileActiveSlug && Array.isArray(categories) ? (categories.find((cat) => cat.slug === mobileActiveSlug)?.name || null) : null; %>
<% const mobileAllCount = ((categories || [])[0] && categories[0].count) || 0; %>

<div class="mb-4 lg:hidden" data-mobile-category-drawer>
  <button type="button" class="flex w-full items-center justify-between rounded-2xl border border-ink-600 bg-ink-850 px-4 py-3 text-left shadow-card" data-category-sheet-open>
    <span>
      <span class="block text-[11px] font-semibold uppercase tracking-[0.18em] text-gold">商品分類</span>
      <span class="mt-1 block text-sm font-bold text-gray-100"><%= mobileSelectedName || '展開全部分類' %></span>
    </span>
    <span class="rounded-full bg-wine/15 px-3 py-1 text-xs font-bold text-gold-light">篩選</span>
  </button>

  <script type="application/json" data-category-tree-json>
    <%- JSON.stringify({
      tree: mobileCategoryTree,
      specials: mobileSpecialEntries,
      active: mobileActiveSlug,
      allCount: mobileAllCount,
    }) %>
  </script>
</div>
