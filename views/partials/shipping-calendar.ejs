<%
/*
  partials/shipping-calendar.ejs（精簡版）
  - 左：今個月月曆（一格）
  - 右：接下來嘅假期清單（跨月，只列日期，唔畫成個月曆）→ 慳位置
  日本(wine) / 香港(gold) / 兩地(gradient)
  locals:
    - holidaysMap: { 'YYYY-MM-DD': { type:'jp'|'hk'|'both', name } }
*/
const hmap = (typeof holidaysMap === 'object' && holidaysMap) ? holidaysMap : {};
const WEEKDAYS = ['日','一','二','三','四','五','六'];
const MONTH_LABELS = ['1月','2月','3月','4月','5月','6月','7月','8月','9月','10月','11月','12月'];
function pad(n){ return String(n).padStart(2,'0'); }
function keyOf(y,m,d){ return y + '-' + pad(m+1) + '-' + pad(d); }

const today = new Date();
today.setHours(0,0,0,0);

// 今個月 grid
const y0 = today.getFullYear(), m0 = today.getMonth();
const firstWeekday = new Date(y0,m0,1).getDay();
const daysInMonth = new Date(y0,m0+1,0).getDate();
const cells = [];
for (let i=0;i<firstWeekday;i++) cells.push(null);
for (let d=1; d<=daysInMonth; d++) cells.push(d);
while (cells.length % 7 !== 0) cells.push(null);

// 接下來嘅假期（今日起，未來 ~4 個月，最多 8 個）
const upcoming = Object.keys(hmap)
  .filter(k => new Date(k+'T00:00:00') >= today)
  .sort()
  .slice(0, 8)
  .map(k => ({ k, entry: hmap[k] }));
%>
<section id="shipping-calendar" class="mb-6 rounded-3xl border border-ink-600 bg-ink-850 p-6 shadow-card">
  <div class="mb-5 flex items-end justify-between gap-4">
    <div>
      <h2 class="mz-display text-xl font-black text-white">📅 出貨日曆</h2>
      <p class="mt-1 text-sm text-gray-400">日本假期暫停入貨、香港假期暫停出貨，週末休息</p>
    </div>
  </div>

  <div class="grid gap-6 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
    <!-- 今個月 -->
    <div class="rounded-2xl border border-ink-700 bg-ink-900 p-4">
      <div class="mb-3 flex items-center justify-between">
        <span class="text-sm font-black text-gold-light"><%= y0 %>年 <%= MONTH_LABELS[m0] %></span>
      </div>
      <div class="grid grid-cols-7 gap-1 text-center text-[11px] font-bold text-gray-500">
        <% WEEKDAYS.forEach((w,i)=>{ %>
          <div class="<%= (i===0)?'text-wine-light':(i===6?'text-sky-400':'') %>"><%= w %></div>
        <% }) %>
      </div>
      <div class="mt-1 grid grid-cols-7 gap-1 text-center text-xs">
        <% cells.forEach(d=>{
             if(!d){ %><div class="aspect-square"></div><% } else {
               const k = keyOf(y0,m0,d);
               const dow = new Date(y0,m0,d).getDay();
               const entry = hmap[k] || null;
               const isToday = (new Date(y0,m0,d).getTime()===today.getTime());
               const isWeekend = (dow===0||dow===6);
               let cls='text-gray-300', title='';
               if(entry){
                 const ty=entry.type;
                 if(ty==='both') cls='bg-gradient-to-br from-wine/30 to-gold/30 text-white font-black ring-1 ring-gold/60';
                 else if(ty==='jp') cls='bg-wine/25 text-wine-light font-black ring-1 ring-wine/50';
                 else cls='bg-gold/20 text-gold-light font-black ring-1 ring-gold/50';
                 title=entry.name;
               } else if(isWeekend){ cls='text-wine-light'; title=(dow===0?'星期日':'星期六')+'休息'; }
               if(isToday){ cls += ' ring-2 ring-gold'; }
        %>
          <div class="flex aspect-square items-center justify-center rounded-md <%= cls %>" <%= title?('title="'+title+'"'):'' %>><%= d %></div>
        <% } }) %>
      </div>
    </div>

    <!-- 接下來假期清單 -->
    <div class="rounded-2xl border border-ink-700 bg-ink-900 p-4">
      <div class="mb-3 text-sm font-black text-gold-light">接下來嘅假期／唔出貨日子</div>
      <ul class="divide-y divide-ink-700">
        <% upcoming.forEach(u=>{
             const [yy,mm,dd]=u.k.split('-').map(Number);
             const ty=u.entry.type;
             const dot = ty==='both' ? 'bg-gradient-to-br from-wine to-gold'
                       : ty==='jp' ? 'bg-wine' : 'bg-gold';
        %>
          <li class="flex items-center gap-3 py-2">
            <span class="h-2.5 w-2.5 shrink-0 rounded-full <%= dot %>"></span>
            <span class="w-14 shrink-0 text-sm font-black text-gray-100"><%= dd %><%= MONTH_LABELS[mm-1] %></span>
            <span class="min-w-0 flex-1 truncate text-xs text-gray-300"><%= u.entry.name %></span>
          </li>
        <% }) %>
        <% if(!upcoming.length){ %><li class="py-2 text-xs text-gray-500">暫時無假期</li><% } %>
      </ul>
    </div>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-gray-400">
    <span class="inline-flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-wine"></span>日本假期（暫停入貨）</span>
    <span class="inline-flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-gold"></span>香港假期（暫停出貨）</span>
    <span class="inline-flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-gradient-to-br from-wine to-gold"></span>兩地皆假期</span>
    <span class="text-gray-500">※ 假期前後訂單或有延誤，實際以 WhatsApp 通知為準</span>
  </div>
</section>
