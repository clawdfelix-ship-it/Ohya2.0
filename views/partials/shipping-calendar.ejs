<%
/*
  partials/shipping-calendar.ejs
  出荷カレンダー：今月＋直近2ヶ月をサーバー側で描画。
  日本の祝日/休業日（data/japan-holidays.json）と土日を「出荷停止」として表示。
  locals:
    - holidaysMap: { 'YYYY-MM-DD': '休業名' } （route 側で渡す）
*/
const hmap = (typeof holidaysMap === 'object' && holidaysMap) ? holidaysMap : {};
const WEEKDAYS = ['日','一','二','三','四','五','六'];
const MONTH_LABELS = ['1月','2月','3月','4月','5月','6月','7月','8月','9月','10月','11月','12月'];
function pad(n){ return String(n).padStart(2,'0'); }
function keyOf(y,m,d){ return y + '-' + pad(m+1) + '-' + pad(d); }

const today = new Date();
today.setHours(0,0,0,0);
const months = [];
for (let off=0; off<3; off++) {
  const base = new Date(today.getFullYear(), today.getMonth()+off, 1);
  const y = base.getFullYear(), m = base.getMonth();
  const firstWeekday = new Date(y,m,1).getDay(); // 0=日
  const daysInMonth = new Date(y,m+1,0).getDate();
  // 6週×7固定グリッドに埋める
  const cells = [];
  for (let i=0;i<firstWeekday;i++) cells.push(null);
  for (let d=1; d<=daysInMonth; d++) cells.push(d);
  while (cells.length % 7 !== 0) cells.push(null);
  months.push({ y,m,cells });
}
%>
<section id="shipping-calendar" class="mb-6 rounded-3xl border border-ink-600 bg-ink-850 p-6 shadow-card">
  <div class="mb-5 flex items-end justify-between gap-4">
    <div>
      <h2 class="mz-display text-xl font-black text-white">📅 出貨日曆</h2>
      <p class="mt-1 text-sm text-gray-400">日本假期及週末暫停出貨，落單前可參考以下日子安排</p>
    </div>
  </div>

  <div class="grid gap-5 md:grid-cols-3">
    <% months.forEach(mm => { %>
      <div class="rounded-2xl border border-ink-700 bg-ink-900 p-4">
        <div class="mb-3 flex items-center justify-between">
          <span class="text-sm font-black text-gold-light"><%= mm.y %>年 <%= MONTH_LABELS[mm.m] %></span>
        </div>
        <div class="grid grid-cols-7 gap-1 text-center text-[11px] font-bold text-gray-500">
          <% WEEKDAYS.forEach((w,i)=>{ %>
            <div class="<%= (i===0)?'text-wine-light':(i===6?'text-sky-400':'') %>"><%= w %></div>
          <% }) %>
        </div>
        <div class="mt-1 grid grid-cols-7 gap-1 text-center text-xs">
          <% mm.cells.forEach(d=>{
               if(!d){ %><div class="aspect-square"></div><% } else {
                 const k = keyOf(mm.y,mm.m,d);
                 const dow = new Date(mm.y,mm.m,d).getDay();
                 const hol = hmap[k] || null;
                 const isToday = (new Date(mm.y,mm.m,d).getTime()===today.getTime());
                 const isWeekend = (dow===0||dow===6);
                 let cls='text-gray-300';
                 let title='';
                 if(hol){ cls='bg-wine/25 text-wine-light font-black ring-1 ring-wine/50'; title=hol; }
                 else if(isWeekend){ cls='text-wine-light'; title=(dow===0?'星期日':'星期六')+'唔出貨'; }
                 if(isToday){ cls += ' ring-2 ring-gold'; }
          %>
            <div class="flex aspect-square items-center justify-center rounded-md <%= cls %>" <%= title?('title="'+title+'"'):'' %>>
              <%= d %>
            </div>
          <% } }) %>
        </div>
      </div>
    <% }) %>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-gray-400">
    <span class="inline-flex items-center gap-2"><span class="h-3 w-3 rounded bg-wine/40 ring-1 ring-wine/60"></span>日本假期／休業（唔出貨）</span>
    <span class="inline-flex items-center gap-2"><span class="h-3 w-3 rounded text-wine-light">日六</span>週末唔出貨</span>
    <span class="inline-flex items-center gap-2"><span class="h-3 w-3 rounded ring-2 ring-gold"></span>今日</span>
    <span class="text-gray-500">※ 假期前後訂單或有延誤，實際以 WhatsApp 通知為準</span>
  </div>
</section>
