<%
/*
  partials/shipping-calendar.ejs
  - 今個月曆：置中，大格（主角）
  - 下個月迷你曆：釘喺右上角（md 以上先顯示，唔阻手機）
  日本(wine) / 香港(gold) / 兩地(gradient)
  locals:
    - holidaysMap: { 'YYYY-MM-DD': { type:'jp'|'hk'|'both', name } }
*/
const hmap = (typeof holidaysMap === 'object' && holidaysMap) ? holidaysMap : {};
const WEEKDAYS = ['日','一','二','三','四','五','六'];
const MONTH_LABELS = ['1月','2月','3月','4月','5月','6月','7月','8月','9月','10月','11月','12月'];
function pad(n){ return String(n).padStart(2,'0'); }
function keyOf(y,m,d){ return y + '-' + pad(m+1) + '-' + pad(d); }

function buildMonth(offset){
  const base = new Date();
  const t = new Date(base.getFullYear(), base.getMonth()+offset, 1);
  const y=t.getFullYear(), m=t.getMonth();
  const firstWeekday=new Date(y,m,1).getDay();
  const daysInMonth=new Date(y,m+1,0).getDate();
  const cells=[];
  for(let i=0;i<firstWeekday;i++) cells.push(null);
  for(let d=1;d<=daysInMonth;d++) cells.push(d);
  while(cells.length%7!==0) cells.push(null);
  return {y,m,cells};
}

const today = new Date(); today.setHours(0,0,0,0);
const cur = buildMonth(0);
const next = buildMonth(1);

// 每格點樣（共用）
function cellState(mm,d){
  const k=keyOf(mm.y,mm.m,d);
  const dow=new Date(mm.y,mm.m,d).getDay();
  const entry=hmap[k]||null;
  const isToday=(new Date(mm.y,mm.m,d).getTime()===today.getTime());
  const isWeekend=(dow===0||dow===6);
  let cls='text-gray-300', title='';
  if(entry){
    const ty=entry.type;
    if(ty==='both') cls='bg-gradient-to-br from-wine/30 to-gold/30 text-white font-black ring-1 ring-gold/60';
    else if(ty==='jp') cls='bg-wine/25 text-wine-light font-black ring-1 ring-wine/50';
    else cls='bg-gold/20 text-gold-light font-black ring-1 ring-gold/50';
    title=entry.name;
  } else if(isWeekend){ cls='text-wine-light'; title=(dow===0?'星期日':'星期六')+'休息'; }
  if(isToday) cls+=' ring-2 ring-gold';
  return {cls,title,isWeekend};
}
%>
<section id="shipping-calendar" class="relative mb-6 rounded-3xl border border-ink-600 bg-ink-850 p-6 shadow-card">
  <div class="mb-5">
    <h2 class="mz-display text-xl font-black text-white">📅 出貨日曆</h2>
    <p class="mt-1 text-sm text-gray-400">日本假期暫停入貨、香港假期暫停出貨，週末休息</p>
  </div>

  <!-- 右上角：下個月迷你曆 -->
  <div class="absolute right-5 top-5 hidden w-40 rounded-2xl border border-ink-700 bg-ink-900 p-2.5 lg:block">
    <div class="mb-2 text-center text-[11px] font-black text-gold-light"><%= next.y %>年 <%= MONTH_LABELS[next.m] %></div>
    <div class="grid grid-cols-7 gap-0.5 text-center text-[8px] font-bold text-gray-500">
      <% WEEKDAYS.forEach((w,i)=>{ %><div class="<%= (i===0||i===6)?'text-wine-light':'' %>"><%= w %></div><% }) %>
    </div>
    <div class="mt-0.5 grid grid-cols-7 gap-0.5 text-center text-[9px]">
      <% next.cells.forEach(d=>{
           if(!d){ %><div></div><% } else {
             const s=cellState(next,d);
             // 迷你版：簡化成底色/圓點，唔放 ring
             let mini=s.cls.replace(/ring-[^ ]+/g,'').replace(/font-black/g,'');
        %>
          <div class="flex h-4 items-center justify-center rounded <%= mini %>" <%= s.title?('title="'+s.title+'"'):'' %>><%= d %></div>
        <% } }) %>
    </div>
  </div>

  <!-- 中間：今個月大曆 -->
  <div class="mx-auto max-w-md rounded-2xl border border-ink-700 bg-ink-900 p-5">
    <div class="mb-4 text-center text-base font-black text-gold-light"><%= cur.y %>年 <%= MONTH_LABELS[cur.m] %></div>
    <div class="grid grid-cols-7 gap-1 text-center text-xs font-bold text-gray-500">
      <% WEEKDAYS.forEach((w,i)=>{ %>
        <div class="<%= (i===0)?'text-wine-light':(i===6?'text-sky-400':'') %>"><%= w %></div>
      <% }) %>
    </div>
    <div class="mt-1 grid grid-cols-7 gap-1 text-center text-sm">
      <% cur.cells.forEach(d=>{
           if(!d){ %><div class="aspect-square"></div><% } else {
             const s=cellState(cur,d);
        %>
          <div class="flex aspect-square items-center justify-center rounded-md <%= s.cls %>" <%= s.title?('title="'+s.title+'"'):'' %>><%= d %></div>
        <% } }) %>
    </div>
  </div>

  <div class="mt-5 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-gray-400">
    <span class="inline-flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-wine"></span>日本假期（暫停入貨）</span>
    <span class="inline-flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-gold"></span>香港假期（暫停出貨）</span>
    <span class="inline-flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-gradient-to-br from-wine to-gold"></span>兩地皆假期</span>
    <span class="w-full text-center text-gray-500">※ 假期前後訂單或有延誤，實際以 WhatsApp 通知為準</span>
  </div>
</section>
