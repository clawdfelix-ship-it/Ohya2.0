<% const categoryTreeData = Array.isArray(categoriesTree) ? categoriesTree : []; %>
<% const activeSlug = typeof selectedCategorySlug === 'string' ? selectedCategorySlug : null; %>
<%
  function nodeContainsActive(node, slug) {
    if (!node || !slug) return false;
    if (node.slug === slug) return true;
    return Array.isArray(node.children) && node.children.some((child) => nodeContainsActive(child, slug));
  }
%>
<aside id="wrap_left" class="hidden lg:block lg:w-64 lg:flex-shrink-0">
  <div class="sticky top-24">
    <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
      <div class="border-b border-gray-200 px-4 py-4">
        <div class="text-sm font-black text-gray-900">商品分類</div>
        <p class="mt-1 text-xs text-gray-500">預設展開第一層，想再深入可以逐級展開。</p>
      </div>

      <div class="max-h-[calc(100vh-10rem)] overflow-y-auto px-3 py-3">
        <a href="/products?page=1" class="<%= !activeSlug || activeSlug === 'all' ? 'bg-red-50 text-red-700 border-red-200' : 'border-transparent text-gray-700 hover:bg-gray-50' %> mb-2 flex items-center justify-between rounded-xl border px-3 py-2.5 text-sm font-semibold transition">
          <span>全部商品</span>
          <span class="text-xs text-gray-500"><%= ((categories || [])[0] && categories[0].count) || 0 %></span>
        </a>

        <div class="space-y-2" data-sidebar-accordion>
          <% categoryTreeData.forEach(cat => { %>
            <%- include('category-tree-node', { node: cat, depth: 0, activeSlug, nodeContainsActive }) %>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</aside>

<script>
  (function initSidebarAccordion() {
    const root = document.querySelector('[data-sidebar-accordion]');
    if (!root) return;
    const items = Array.from(root.querySelectorAll('[data-sidebar-root]'));
    items.forEach((item) => {
      item.addEventListener('toggle', () => {
        if (!item.open) return;
        const opened = items.filter((entry) => entry.open);
        if (opened.length <= 2) return;
        for (const entry of opened) {
          if (entry !== item && opened.length > 2) {
            entry.open = false;
            opened.splice(opened.indexOf(entry), 1);
          }
        }
      });
    });
  })();
</script>
