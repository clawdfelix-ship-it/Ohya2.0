<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · OHYA2.0</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/mzakka-theme.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <meta name="robots" content="index,follow">
  <style>
    body { font-family: 'Noto Sans TC', sans-serif; }
    .jpn-bracket::before { content: '【'; }
    .jpn-bracket::after { content: '】'; }
    .info-card h2 { font-size: 1.25rem; font-weight: 800; color:#111827; margin:1.75rem 0 .6rem; }
    .info-card h2:first-child { margin-top:0; }
    .info-card h3 { font-size:1.05rem; font-weight:700; color:#1f2937; margin:1.1rem 0 .4rem; }
    .info-card p { color:#374151; line-height:1.8; margin:.5rem 0; }
    .info-card ul { list-style:disc; padding-left:1.4rem; color:#374151; line-height:1.9; margin:.5rem 0; }
    .info-card ol { list-style:decimal; padding-left:1.4rem; color:#374151; line-height:1.9; margin:.5rem 0; }
    .info-card a { color:#b91c1c; text-decoration:underline; text-underline-offset:2px; }
    .info-card table { width:100%; border-collapse:collapse; margin:.75rem 0; font-size:.92rem; }
    .info-card th, .info-card td { border:1px solid #e5e7eb; padding:.55rem .7rem; text-align:left; vertical-align:top; }
    .info-card th { background:#f9fafb; font-weight:700; }
  </style>
</head>
<body class="mz-body text-black min-h-screen" data-logged-in="<%= user ? '1' : '0' %>">

  <%- include('age-modal') %>
  <%- include('header') %>

  <div id="mz-wrapper" class="mz-wrapper max-w-7xl mx-auto px-2 mt-4 mb-4">
    <div class="mz-3col">
      <%- include('sidebar-left') %>

      <div id="wrap_center" class="min-w-0">
        <div class="max-w-4xl mx-auto px-0 sm:px-4 lg:px-6 py-6">
          <nav class="mb-3 text-xs text-gray-500" aria-label="麵包屑">
            <a href="/" class="hover:text-red-700">首頁</a>
            <span class="mx-1">/</span>
            <span class="text-gray-700"><%= title %></span>
          </nav>
          <h1 class="text-2xl sm:text-3xl font-black text-gray-900 mb-1 jpn-bracket inline-block"><%= title %></h1>
          <% if (typeof pageSubtitle !== 'undefined' && pageSubtitle) { %>
            <p class="mt-3 mb-5 text-sm text-gray-500"><%= pageSubtitle %></p>
          <% } else { %>
            <div class="mb-5"></div>
          <% } %>
          <div class="info-card rounded-xl border border-gray-200 bg-white p-5 sm:p-8 text-[15px]">
