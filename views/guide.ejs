<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <% const _pageTitle = (typeof seo !== "undefined" && seo && seo.title) ? seo.title : title; %><title><%= _pageTitle %><%- String(_pageTitle).includes("OHYA2.0") ? "" : " · OHYA2.0" %></title>
  <%- include('partials/seo-meta') %>
  <script src="https://cdn.tailwindcss.com"></script>
  <%- include('partials/theme-head') %>
  <link rel="stylesheet" href="/css/mzakka-theme.css">
  <link rel="stylesheet" href="/css/interactions.css">
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
</head>
<body class="mz-body min-h-screen text-gray-200" data-logged-in="<%= user ? '1' : '0' %>">
  <%- include('partials/age-modal') %>
  <%- include('partials/header') %>

  <div id="mz-wrapper" class="mz-wrapper max-w-7xl mx-auto px-2 mt-4 mb-4">
    <div class="mz-3col">
      <%- include('partials/sidebar-left') %>

      <div id="wrap_center" class="min-w-0">
        <div class="max-w-4xl mx-auto px-0 sm:px-4 lg:px-6 py-6">
          <nav class="mb-3 text-xs text-gray-500" aria-label="麵包屑">
            <a href="/" class="hover:text-gold-light">首頁</a>
            <span class="mx-1">/</span>
            <span class="text-gray-300">選購指南</span>
          </nav>
          <h1 class="mz-display text-2xl sm:text-3xl font-black text-white mb-1 jpn-bracket inline-block">選購指南</h1>
          <p class="mt-3 mb-5 text-sm text-gray-400">日本成人用品選購教學、品類比較、使用心得。由我哋 14 年入口經驗整理，幫你揀到最啱嘅產品。</p>

          <% if (posts && posts.length > 0) { %>
            <div class="grid gap-4 sm:grid-cols-2">
              <% posts.forEach((post) => { %>
                <a href="/guide/<%= post.slug %>" class="group rounded-2xl border border-ink-600 bg-ink-850 p-5 shadow-card transition hover:border-gold/50">
                  <% if (post.featured_image) { %>
                    <div class="mb-3 rounded-xl overflow-hidden bg-ink-800 aspect-video">
                      <img src="<%= post.featured_image %>" alt="<%= post.title %>" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                    </div>
                  <% } %>
                  <h2 class="text-lg font-bold text-white group-hover:text-gold-light transition"><%= post.title %></h2>
                  <% if (post.excerpt) { %>
                    <p class="mt-2 text-sm text-gray-400 leading-relaxed line-clamp-3"><%= post.excerpt %></p>
                  <% } %>
                  <% if (post.publish_at) { %>
                    <p class="mt-3 text-xs text-gray-500"><%= new Date(post.publish_at).toLocaleDateString('zh-HK') %></p>
                  <% } %>
                </a>
              <% }) %>
            </div>
          <% } else { %>
            <div class="rounded-2xl border border-ink-600 bg-ink-850 p-8 text-center text-gray-400">
              <p class="mb-2">📝 選購指南陸續有嚟</p>
              <p class="text-sm">我哋會陸續分享日本成人用品嘅選購心得、品類比較同使用教學。敬請留意。</p>
            </div>
          <% } %>
        </div>
      </div>

      <%- include('partials/sidebar-right') %>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
