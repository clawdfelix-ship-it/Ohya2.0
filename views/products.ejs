<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/mzakka-theme.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Noto Sans TC', sans-serif; }
    .jpn-bracket { position: relative; padding: 0 1em; }
    .jpn-bracket::before, .jpn-bracket::after {
      content: ''; position: absolute; top: 50%; width: 0.4em; height: 1em;
      border: 2px solid #dc2626; transform: translateY(-50%);
    }
    .jpn-bracket::before { left: 0; border-right: none; }
    .jpn-bracket::after { right: 0; border-left: none; }
    .modal-animate { animation: modalPop 0.3s ease-out; }
    @keyframes modalPop {
      from { opacity: 0; transform: scale(0.9); }
      to { opacity: 1; transform: scale(1); }
    }
  </style>
</head>
<body class="mz-body min-h-screen bg-gray-50 text-black">
  <%- include('partials/age-modal') %>

  <%- include('partials/header') %>

  <div id="mz-wrapper" class="max-w-7xl mx-auto px-3 py-6">
    <div class="lg:grid lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-6">
      <%- include('partials/sidebar-left') %>

      <div id="wrap_center" class="min-w-0">
  <main class="px-0 py-0">
    <section class="mb-6 rounded-3xl border border-gray-200 bg-white p-5 shadow-sm">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-red-600">Product Listing</p>
          <h1 class="mt-2 text-3xl font-black text-gray-900"><%= selectedCategory && selectedCategory !== '全部商品' ? selectedCategory : '全部商品' %></h1>
          <p class="mt-2 text-sm text-gray-500">將分類留喺左欄，主內容只專心顯示商品、排序同結果數量。</p>
        </div>
        <div class="rounded-2xl bg-gray-50 px-4 py-3 text-sm text-gray-500">
          已找到 <span class="font-black text-gray-900"><%= (typeof total === 'number' ? total : products.length) %></span> 件商品
        </div>
      </div>
    </section>

    <%- include('partials/category-mobile-drawer') %>

    <!-- 排序 -->
    <div class="mb-6 flex items-center justify-between rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
      <div class="text-sm text-gray-500">排序結果已按你目前分類與搜尋條件更新</div>
      <div class="flex gap-2">
        <select id="mz-sort" class="rounded-full border border-gray-300 px-3 py-2 text-sm focus:border-red-500 focus:outline-none">
          <option value="recommend" <%= (typeof sort === 'string' ? sort : 'recommend') === 'recommend' ? 'selected' : '' %>>推介排序</option>
          <option value="price_asc" <%= (typeof sort === 'string' ? sort : 'recommend') === 'price_asc' ? 'selected' : '' %>>價格由低至高</option>
          <option value="price_desc" <%= (typeof sort === 'string' ? sort : 'recommend') === 'price_desc' ? 'selected' : '' %>>價格由高至低</option>
          <option value="newest" <%= (typeof sort === 'string' ? sort : 'recommend') === 'newest' ? 'selected' : '' %>>最新上架</option>
          <option value="popular" <%= (typeof sort === 'string' ? sort : 'recommend') === 'popular' ? 'selected' : '' %>>人氣排序</option>
        </select>
      </div>
    </div>

    <!-- 產品列表 -->
    <% if (products && products.length > 0) { %>
      <div class="grid grid-cols-2 gap-4 md:grid-cols-3 xl:grid-cols-4">
        <% products.forEach(product => { %>
          <div class="group overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition duration-300 hover:-translate-y-0.5 hover:shadow-lg">
            <a href="/product/<%= product.id %>" class="block">
              <div class="relative aspect-square overflow-hidden bg-gray-50">
                <div class="absolute left-2 top-2 z-10 flex flex-col gap-1">
                  <% if (product.originalPrice && product.originalPrice > product.price) { %>
                    <span class="rounded-full bg-red-600 px-2 py-1 text-xs font-bold text-white"><%= t('product.badge.deal') %></span>
                    <span class="rounded-full bg-orange-500 px-2 py-1 text-xs font-bold text-white">-<%= Math.round((1 - product.price / product.originalPrice) * 100) %>%OFF</span>
                  <% } %>
                  <% if (product.stock <= 20) { %>
                    <span class="rounded-full bg-yellow-500 px-2 py-1 text-xs font-bold text-black"><%= t('product.badge.lowStock') %></span>
                  <% } %>
                </div>
                <% if (product.image) { %>
                  <img src="<%= product.image %>" alt="<%= product.name %>" class="h-full w-full object-cover transition duration-300 group-hover:scale-105">
                <% } else { %>
                  <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-gray-100 to-gray-200 text-6xl">📦</div>
                <% } %>
              </div>
              <div class="p-4">
                <span class="rounded-full bg-red-50 px-2 py-1 text-xs font-bold text-red-600"><%= product.category %></span>
                <h3 class="mt-3 mb-2 h-10 line-clamp-2 text-sm font-medium leading-tight"><%= product.name %></h3>
                <div class="mb-3">
                  <span class="text-xl font-black text-red-600"><%= formatPrice(product.price) %></span>
                  <% if (product.originalPrice && product.originalPrice > product.price) { %>
                    <span class="text-xs text-gray-400 line-through ml-1"><%= formatPrice(product.originalPrice) %></span>
                  <% } %>
                </div>
                <div class="mb-3 text-xs text-red-600">
                  <span class="font-bold">積分：<%= Math.floor(product.price / 100) %>pt</span><span class="text-gray-400">（1 倍）</span>
                </div>
                <div class="flex gap-2">
                  <a href="/product/<%= product.id %>" class="flex-1 rounded-full bg-red-600 py-2 text-center text-xs font-bold text-white transition hover:bg-red-700"><%= t('product.cta.details') %></a>
                  <button onclick="addToCart(this)" data-product-id="<%= product.id %>" class="rounded-full bg-orange-500 px-3 py-2 text-xs font-bold text-white transition hover:bg-orange-600">🛒</button>
                </div>
              </div>
            </a>
          </div>
        <% }) %>
      </div>
      <div class="flex justify-center mt-8">
        <% 
          const currentPage = typeof page === 'number' ? page : 1;
          const pages = typeof totalPages === 'number' ? totalPages : 1;
          const qParam = (typeof q === 'string' && q.trim()) ? ('&q=' + encodeURIComponent(q.trim())) : '';
          const sortParam = (typeof sort === 'string' && sort) ? ('&sort=' + encodeURIComponent(sort)) : '';
          const base = selectedCategorySlug && selectedCategorySlug !== 'all'
            ? ('/products?category=' + encodeURIComponent(selectedCategorySlug) + qParam + sortParam + '&page=')
            : ('/products?' + (qParam ? qParam.slice(1) + '&' : '') + (sortParam ? sortParam.slice(1) + '&' : '') + 'page=');
          const startPage = Math.max(1, currentPage - 2);
          const endPage = Math.min(pages, currentPage + 2);
        %>
        <div class="flex gap-1">
          <% if (currentPage <= 1) { %>
            <button class="w-9 h-9 border border-gray-300 rounded font-bold text-gray-400 cursor-not-allowed">«</button>
          <% } else { %>
            <a href="<%= base + (currentPage - 1) %>" class="w-9 h-9 border border-gray-300 rounded font-bold hover:bg-gray-100 transition flex items-center justify-center">«</a>
          <% } %>

          <% if (startPage > 1) { %>
            <a href="<%= base + 1 %>" class="w-9 h-9 border border-gray-300 rounded font-bold hover:bg-gray-100 transition flex items-center justify-center">1</a>
            <% if (startPage > 2) { %>
              <span class="w-9 h-9 flex items-center justify-center text-gray-400">...</span>
            <% } %>
          <% } %>

          <% for (let i = startPage; i <= endPage; i++) { %>
            <% if (i === currentPage) { %>
              <span class="w-9 h-9 bg-red-600 text-white rounded font-bold flex items-center justify-center"><%= i %></span>
            <% } else { %>
              <a href="<%= base + i %>" class="w-9 h-9 border border-gray-300 rounded font-bold hover:bg-gray-100 transition flex items-center justify-center"><%= i %></a>
            <% } %>
          <% } %>

          <% if (endPage < pages) { %>
            <% if (endPage < pages - 1) { %>
              <span class="w-9 h-9 flex items-center justify-center text-gray-400">...</span>
            <% } %>
            <a href="<%= base + pages %>" class="w-9 h-9 border border-gray-300 rounded font-bold hover:bg-gray-100 transition flex items-center justify-center"><%= pages %></a>
          <% } %>

          <% if (currentPage >= pages) { %>
            <button class="w-9 h-9 border border-gray-300 rounded font-bold text-gray-400 cursor-not-allowed">»</button>
          <% } else { %>
            <a href="<%= base + (currentPage + 1) %>" class="w-9 h-9 border border-gray-300 rounded font-bold hover:bg-gray-100 transition flex items-center justify-center">»</a>
          <% } %>
        </div>
      </div>
    <% } else { %>
      <div class="rounded-2xl border border-gray-200 bg-white py-20 text-center shadow-sm">
        <span class="text-6xl mb-4 block">📦</span>
        <p class="text-gray-500 mb-4">未找到相關商品</p>
        <a href="/products" class="inline-block rounded-full bg-red-600 px-8 py-2 text-white font-bold transition hover:bg-red-700">查看全部商品</a>
      </div>
    <% } %>
  </main>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script>
    function verifyAge(isAdult) {
      if (isAdult) {
        document.getElementById('ageModal').classList.add('hidden');
        localStorage.setItem('ageVerified', 'true');
      } else {
        window.location.href = 'https://www.google.com.hk/';
      }
    }
    if (!localStorage.getItem('ageVerified')) {
      document.getElementById('ageModal').classList.remove('hidden');
    }
    function addToCart(btn) {
      const productId = btn.dataset.productId;
      const countEl = document.getElementById('cart-count');
      const current = parseInt(countEl.textContent);
      countEl.textContent = current + 1;
      alert('已加入購物車！');
    }

    function toggleCategories() {
      const list = document.getElementById('catList');
      const toggle = document.getElementById('catToggle');
      if (!list || !toggle) return;
      const hidden = list.classList.contains('hidden');
      if (hidden) {
        list.classList.remove('hidden');
        toggle.textContent = '▲';
      } else {
        list.classList.add('hidden');
        toggle.textContent = '▼';
      }
    }

    (function initSort() {
      const sel = document.getElementById('mz-sort');
      if (!sel) return;
      sel.addEventListener('change', function () {
        const params = new URLSearchParams(window.location.search);
        params.set('sort', String(sel.value || 'recommend'));
        params.set('page', '1');
        const next = window.location.pathname + '?' + params.toString();
        window.location.href = next;
      });
    })();
  </script>
</body>
</html>
