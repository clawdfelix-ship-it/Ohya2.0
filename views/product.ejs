<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/mzakka-theme.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <style>
    body {
      font-family: 'Noto Sans TC', sans-serif;
    }
    .jpn-bracket::before { content: '【'; }
    .jpn-bracket::after { content: '】'; }
    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .modal-animate {
      animation: slideDown 0.3s ease-out;
    }
  </style>
</head>
<body class="mz-body min-h-screen bg-gray-50 text-black" data-logged-in="<%= user ? '1' : '0' %>">

  <%- include('partials/age-modal') %>

  <%- include('partials/header') %>

  <div id="mz-wrapper" class="max-w-7xl mx-auto px-3 py-6">
    <div class="lg:grid lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-6">
      <%- include('partials/sidebar-left') %>

      <div id="wrap_center" class="min-w-0">

  <div class="px-0 py-2">
  <div class="max-w-7xl mx-auto px-0 py-3">
    <nav class="text-xs text-gray-500">
      <a href="/" class="hover:text-red-600">首頁</a>
      <span class="mx-2">›</span>
      <a href="/products" class="hover:text-red-600">商品列表</a>
      <span class="mx-2">›</span>
      <span class="text-red-600 font-medium"><%= product.name %></span>
    </nav>
  </div>

  <%- include('partials/category-mobile-drawer') %>

  <!-- 商品詳情 -->
  <div class="max-w-7xl mx-auto px-0 py-4">
    <div class="overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-sm">
      <div class="grid grid-cols-1 gap-8 p-6 lg:grid-cols-2">
        <!-- 商品圖片 -->
        <div class="space-y-3">
          <div class="relative flex aspect-square items-center justify-center rounded-2xl border border-gray-200 bg-gray-50 p-8">
            <% if (product.originalPrice && product.originalPrice > product.price) { %>
              <div class="absolute top-4 left-4 z-10">
                <span class="rounded-full bg-red-600 px-4 py-2 text-sm font-bold text-white">
                  <%= t('product.badge.deal') %>
                </span>
              </div>
            <% } %>

            <% const gallery = (product && Array.isArray(product.images) && product.images.length) ? product.images : (product.image ? [product.image] : []); %>
            <% if (gallery.length) { %>
              <img id="mz-product-main-image" src="<%= gallery[0] %>" alt="<%= product.name %>" fetchpriority="high" decoding="async" class="h-full w-full rounded-2xl object-contain">
            <% } else { %>
              <span class="text-9xl">📦</span>
            <% } %>
          </div>

          <% if (gallery.length > 1) { %>
            <div id="mz-product-thumbs" class="grid grid-cols-5 gap-2">
              <% gallery.slice(0, 10).forEach((img, idx) => { %>
                <button type="button" data-mz-image="<%= img %>" aria-label="切換圖片 <%= idx + 1 %>" class="<%= idx === 0 ? 'ring-2 ring-red-600' : 'ring-1 ring-gray-200' %> aspect-square overflow-hidden rounded-2xl bg-white">
                  <img src="<%= img %>" alt="" loading="lazy" decoding="async" class="w-full h-full object-cover">
                </button>
              <% }) %>
            </div>
          <% } %>
        </div>
        
        <!-- 商品資料 -->
        <div class="flex flex-col">
          <span class="mb-3 w-fit rounded-full bg-red-50 px-3 py-1 text-xs font-bold text-red-600"><%= product.category %></span>
          <h1 class="text-2xl font-black text-gray-900 mb-4"><%= product.name %></h1>
          <% const detailSections = Array.isArray(product && product.sections) ? product.sections : []; %>
<%# 價格已由本店 HKD 價位區顯示，唔重複顯示 mzakka 日元販売価格 %>
          <% const HIDDEN_INFO_LABELS = ['販売価格']; %>
          <% const productInfoSection = (() => {
            const sec = detailSections.find(section => section && section.sectionType === 'product_info' && section.contentJson && Array.isArray(section.contentJson.rows));
            if (!sec) return null;
            const rows = (sec.contentJson.rows || []).filter(row => !HIDDEN_INFO_LABELS.includes(String((row && row.label) || '').trim()));
            return rows.length ? Object.assign({}, sec, { contentJson: Object.assign({}, sec.contentJson, { rows }) }) : null;
          })(); %>
          <% const narrativeSections = detailSections.filter(section => section && section.sectionType !== 'product_info' && ((section.contentHtml && String(section.contentHtml).trim()) || (section.contentText && String(section.contentText).trim()))); %>
          <% const fallbackDescription = (() => {
               const rawDesc = (product && product.description != null) ? String(product.description).trim() : '';
               const rawName = (product && product.name != null) ? String(product.name).trim() : '';
               return (rawDesc && rawDesc !== rawName) ? rawDesc : '';
             })(); %>
          
          <!-- 價格 -->
          <div class="mb-6 rounded-2xl bg-gray-50 p-5">
            <div class="flex items-baseline gap-3">
              <span class="text-4xl font-black text-red-600"><%= formatPrice(product.price) %></span>
              <% if (product.originalPrice && product.originalPrice > product.price) { %>
                <span class="text-lg text-gray-500 line-through"><%= formatPrice(product.originalPrice) %></span>
                <span class="rounded-full bg-red-100 px-3 py-1 text-sm font-bold text-red-600">
                  <%= Math.round((1 - product.price / product.originalPrice) * 100) %>%OFF
                </span>
              <% } %>
            </div>
            <div class="mt-3 text-sm text-gray-600">
              <span class="text-red-600 font-bold">可獲積分：<%= Math.floor(product.price / 100) %>pt</span>
              <span class="text-gray-500 ml-2">（1 倍）</span>
            </div>
          </div>
          
          <!-- 存貨 -->
          <div class="mb-4 flex items-center gap-4">
            <span class="text-sm">📦 存貨：</span>
            <% if (product.stock > 20) { %>
              <span class="rounded-full bg-green-50 px-3 py-1 text-sm font-bold text-green-600">有貨</span>
            <% } else if (product.stock > 0) { %>
              <span class="rounded-full bg-orange-50 px-3 py-1 text-sm font-bold text-orange-600">存貨緊張（剩餘 <%= product.stock %> 件）</span>
            <% } else { %>
              <span class="rounded-full bg-gray-100 px-3 py-1 text-sm font-bold text-gray-500">缺貨</span>
            <% } %>
          </div>

          <!-- 購物保障信任列 -->
          <ul class="mb-5 grid grid-cols-2 gap-2 rounded-2xl border border-gray-200 bg-gray-50/60 p-3 text-xs font-medium text-gray-600">
            <li class="flex items-center gap-1.5"><span aria-hidden="true">✅</span>正貨保證</li>
            <li class="flex items-center gap-1.5"><span aria-hidden="true">📦</span>保密包裝</li>
            <li class="flex items-center gap-1.5"><span aria-hidden="true">🚚</span>香港本地出貨</li>
            <li class="flex items-center gap-1.5"><span aria-hidden="true">💵</span>支援運費到付</li>
          </ul>
          
          <% if (productInfoSection || narrativeSections.length || fallbackDescription) { %>
            <div class="border-t border-b py-4 mb-6 space-y-4">
              <% if (productInfoSection) { %>
                <section>
                  <h3 class="font-bold text-gray-900 mb-3 jpn-bracket">商品情報</h3>
                  <div class="overflow-hidden rounded-2xl border border-gray-200">
                    <% (productInfoSection.contentJson.rows || []).forEach((row, idx) => { %>
                      <div class="grid grid-cols-[7rem_1fr] gap-3 px-3 py-2 text-sm <%= idx !== 0 ? 'border-t border-gray-100' : '' %>">
                        <div class="font-bold text-gray-700"><%= row.label %></div>
                        <div class="text-gray-600 whitespace-pre-line"><%= row.value %></div>
                      </div>
                    <% }) %>
                  </div>
                </section>
              <% } %>

              <% if (narrativeSections.length) { %>
                <% narrativeSections.forEach((section, idx) => { %>
                  <section>
                    <h3 class="font-bold text-gray-900 mb-3 jpn-bracket"><%= section.title || (idx === 0 ? '商品介紹' : '詳細內容') %></h3>
                    <% if (section.contentHtml) { %>
                      <div class="text-gray-600 leading-relaxed text-sm space-y-3"><%- section.contentHtml %></div>
                    <% } else { %>
                      <div class="text-gray-600 leading-relaxed text-sm whitespace-pre-line"><%= section.contentText %></div>
                    <% } %>
                  </section>
                <% }) %>
              <% } else if (fallbackDescription) { %>
                <section>
                  <h3 class="font-bold text-gray-900 mb-3 jpn-bracket">商品介紹</h3>
                  <div class="text-gray-600 leading-relaxed text-sm whitespace-pre-line"><%= fallbackDescription %></div>
                </section>
              <% } %>
            </div>
          <% } %>
          
          <!-- 購買區 -->
          <div class="mt-auto space-y-4">
            <div class="flex items-center gap-4">
              <label class="text-gray-700 font-medium text-sm" for="quantity">數量：</label>
              <% if (Number(product.stock) <= 0) { %>
                <span class="text-sm font-bold text-gray-500">暫時缺貨</span>
              <% } else { %>
                <div class="flex items-center rounded-full border border-gray-300 bg-white">
                  <button type="button" onclick="changeQuantity(-1)" aria-label="減少數量" class="flex h-11 w-11 items-center justify-center rounded-l-full text-lg hover:bg-gray-100 transition active:scale-95">－</button>
                  <input type="number" id="quantity" value="1" min="1" max="<%= product.stock %>" aria-label="購買數量" class="w-14 h-11 text-center border-x border-gray-300 focus:outline-none font-medium">
                  <button type="button" onclick="changeQuantity(1)" aria-label="增加數量" class="flex h-11 w-11 items-center justify-center rounded-r-full text-lg hover:bg-gray-100 transition active:scale-95">＋</button>
                </div>
              <% } %>
            </div>
            
            <div class="flex gap-3">
              <% if (Number(product.stock) <= 0) { %>
                <button type="button" disabled aria-disabled="true" class="flex flex-1 items-center justify-center gap-2 rounded-full bg-gray-300 py-4 text-lg font-bold text-gray-500 cursor-not-allowed">
                  缺貨中
                </button>
              <% } else { %>
                <button type="button" onclick="addToCart()" class="flex flex-1 min-h-[56px] items-center justify-center gap-2 rounded-full bg-red-600 px-6 text-lg font-bold text-white transition hover:bg-red-700 active:scale-[0.98]">
                  🛒 加入購物車
                </button>
              <% } %>
              <button type="button" aria-label="收藏商品" class="flex h-[56px] w-[56px] items-center justify-center rounded-full bg-gray-100 text-lg transition hover:bg-gray-200 active:scale-95">
                ❤️
              </button>
            </div>
            
            <div class="flex flex-wrap gap-2 text-xs">
              <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full font-medium">🏷️ 小額批發</span>
              <span class="bg-blue-100 text-blue-700 px-3 py-1 rounded-full font-medium">♾️ 數量不限</span>
              <span class="bg-purple-100 text-purple-700 px-3 py-1 rounded-full font-medium">📅 10–14 日寄出</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- 相關商品 -->
    <% if (relatedProducts && relatedProducts.length > 0) { %>
      <div class="mt-10">
        <h2 class="text-xl font-black mb-6 jpn-bracket inline-block">相關商品</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
          <% relatedProducts.forEach(relProduct => { %>
            <div class="group flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition duration-300 hover:-translate-y-0.5 hover:border-red-200 hover:shadow-lg">
              <a href="/product/<%= relProduct.id %>" class="relative block aspect-square overflow-hidden bg-gray-50" aria-label="<%= relProduct.name %>">
                <% if (relProduct.image) { %>
                  <img src="<%= relProduct.image %>" alt="" loading="lazy" decoding="async" class="h-full w-full object-cover transition duration-300 group-hover:scale-105">
                <% } else { %>
                  <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-gray-100 to-gray-200 text-5xl">📦</div>
                <% } %>
              </a>
              <div class="flex flex-1 flex-col p-3">
                <span class="w-fit rounded-full bg-red-50 px-2 py-0.5 text-xs font-bold text-red-600"><%= relProduct.category %></span>
                <h3 class="mt-2 mb-2 h-10 line-clamp-2 text-sm font-medium leading-tight">
                  <a href="/product/<%= relProduct.id %>" class="text-gray-900 transition hover:text-red-700"><%= relProduct.name %></a>
                </h3>
                <span class="mt-auto text-lg font-black text-red-600"><%= formatPrice(relProduct.price) %></span>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>
    
    <!-- 返回 -->
    <div class="mt-8">
      <a href="/products" class="inline-flex items-center gap-2 text-gray-600 hover:text-red-600 font-medium transition">
        ← 返回商品列表
      </a>
    </div>
  </div>
      </div>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script id="mz-product" type="application/json"><%- JSON.stringify(product) %></script>
  <script src="/js/cart-client.js"></script>

  <script>
    const currentProduct = JSON.parse(document.getElementById('mz-product').textContent || '{}');

    // 年齡確認
    function checkAgeVerification() {
      const verified = localStorage.getItem('ageVerified');
      if (!verified) {
        document.getElementById('ageModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    }
    
    function verifyAge(isAdult) {
      if (isAdult) {
        localStorage.setItem('ageVerified', 'true');
        document.getElementById('ageModal').classList.add('hidden');
        document.body.style.overflow = '';
      } else {
        window.location.href = 'https://www.google.com';
      }
    }

    function toggleCategories() {
      const list = document.getElementById('catList');
      const toggle = document.getElementById('catToggle');
      if (!list || !toggle) return;
      const hidden = list.classList.contains('hidden');
      if (hidden) {
        list.classList.remove('hidden');
        toggle.textContent = '▲';
      } else {
        list.classList.add('hidden');
        toggle.textContent = '▼';
      }
    }
    
    // 數量控制（缺貨頁冇數量 input，呢兩個函數唔會被調用）
    function changeQuantity(delta) {
      const input = document.getElementById('quantity');
      if (!input) return;
      const current = parseInt(input.value);
      const max = parseInt(input.max);
      const newVal = Math.max(1, Math.min(max, current + delta));
      input.value = newVal;
    }

    async function addToCart() {
      const input = document.getElementById('quantity');
      const quantity = input ? parseInt(input.value, 10) : 1;
      try {
        await MZCart.add(currentProduct, Number.isFinite(quantity) ? quantity : 1);
        MZCart.toast('已加入購物車！', 'success');
      } catch (error) {
        MZCart.toast(error.message || '加入購物車失敗', 'error');
      }
    }

    function initGalleryThumbs() {
      const main = document.getElementById('mz-product-main-image');
      const thumbs = document.getElementById('mz-product-thumbs');
      if (!main || !thumbs) return;
      thumbs.addEventListener('click', (e) => {
        const btn = e.target && e.target.closest ? e.target.closest('button[data-mz-image]') : null;
        if (!btn) return;
        const src = btn.getAttribute('data-mz-image');
        if (!src) return;
        main.setAttribute('src', src);
        for (const el of thumbs.querySelectorAll('button[data-mz-image]')) {
          el.classList.remove('ring-2', 'ring-red-600');
          el.classList.add('ring-1', 'ring-gray-200');
        }
        btn.classList.remove('ring-1', 'ring-gray-200');
        btn.classList.add('ring-2', 'ring-red-600');
      });
    }
    
    // Initialize
    document.addEventListener('DOMContentLoaded', async function() {
      checkAgeVerification();
      // cart count 由共享 cart-client 自動 refresh
      initGalleryThumbs();
    });
  </script>
</body>
</html>
