<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <%- include('../partials/head', { title }) %>
  <link rel="stylesheet" href="/css/customizer.css">
</head>
<body class="mz-body min-h-screen text-gray-200" data-logged-in="<%= user ? '1' : '0' %>">
  <%- include('../partials/header') %>

  <main id="mz-wrapper" class="mz-wrapper max-w-7xl mx-auto mt-4 mb-6 px-4 py-8">
    <section class="rounded-3xl border border-ink-600 bg-ink-850 p-6 shadow-card">
      <div class="max-w-4xl">
        <div class="text-xs font-bold uppercase tracking-[0.18em] text-gold">Customizer</div>
        <h1 class="mt-2 text-3xl font-black text-white">團體服訂製器</h1>
        <p class="mt-3 max-w-2xl text-sm leading-7 text-gray-400">
          由模板開始或者由空白款開始，建立你嘅球隊設計，再提交名單、效果圖同報價 / 下單資料。
        </p>
      </div>

      <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-5">
        <% ['足球', '籃球', '排球', '背心', 'Polo'].forEach((name) => { %>
          <div class="rounded-2xl border border-ink-600 bg-ink-800 p-4">
            <div class="text-lg font-bold text-white"><%= name %></div>
            <div class="mt-2 text-sm text-gray-400">選擇模板或空白款後進入即時編輯器。</div>
          </div>
        <% }) %>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/customizer/editor?startMode=template" class="rounded-full bg-wine px-5 py-3 text-sm font-bold text-white hover:bg-wine-light">模板開始</a>
        <a href="/customizer/editor?startMode=blank" class="rounded-full border border-ink-500 px-5 py-3 text-sm font-bold text-gray-200 hover:border-gold/60 hover:text-gold-light">空白款開始</a>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
