{
  "version": 2,
  "installCommand": "npm install --omit=dev",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "excludeFiles": [
          "public/**",
          "node_modules/exceljs/dist/**",
          "node_modules/exceljs/excel.js",
          "node_modules/exceljs/index.d.ts",
          "node_modules/exceljs/index.ts",
          "node_modules/exceljs/README*.md"
        ]
      }
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/jobs/daily-sync/refresh",
      "schedule": "30 23 * * *"
    },
    {
      "path": "/api/internal/jobs/daily-sync/process",
      "schedule": "34 23 * * *"
    },
    {
      "path": "/api/internal/jobs/daily-sync/process",
      "schedule": "42 23 * * *"
    },
    {
      "path": "/api/internal/jobs/daily-sync/process",
      "schedule": "50 23 * * *"
    },
    {
      "path": "/api/internal/jobs/mzakka-sync",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/internal/jobs/email-outbox",
      "schedule": "*/5 * * * *"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "^(?:(?:www\\.)?ohyagroups\\.net|ohyagroups\\.com)$" }],
      "dest": "/api/index.js"
    },
    { "src": "/images/(.*)", "dest": "/public/images/$1" },
    { "src": "/css/(.*)", "dest": "/public/css/$1" },
    { "src": "/js/(.*)", "dest": "/public/js/$1" },
    { "src": "/img/(.*)", "dest": "/public/img/$1" },
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/(robots.txt|llms.txt)", "dest": "/public/$1" },
    { "src": "/google8d861a919472c73d.html", "dest": "/public/google8d861a919472c73d.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
